# Copy this file to .env and fill in the values. Never commit .env.

# Password for the admin page. Use a long random password.
ADMIN_PASSWORD=

# Secret that signs admin login tokens. Use a long random string.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Port for the API server. The Vite dev proxy expects 3000.
PORT=3000

# Optional. Where the SQLite database file goes, relative to the server folder.
DATABASE_FILE=data/game.db
